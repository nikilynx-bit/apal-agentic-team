digraph Flow {graph [rankdir=TB,pad=0.25,ranksep=0.24,nodesep=0.3,bgcolor="white",splines=polyline];node [shape=box,fontname="DejaVu Sans",fontsize=12,style="rounded,filled",fillcolor="#edf5f5",color="#c9d8d8",fontcolor="#1d3b43",margin="0.16,0.10"];edge [color="#8097a4",arrowsize=0.55]; a [label="Field request + image + geotag + consent"];b [label="G1 | Evidence / field provenance CHECK",fillcolor="#ffedc3"];c [label="BRAIN regulatory evidence packet (read-only)\nBRAWN checks jurisdiction + current applicability"];d [label="G2 | Legal, tenure and hazard evidence CHECK",fillcolor="#ffedc3"];e [label="Options: elevation, structure, bracing, access\nConcept geometry, preliminary take-off and BOM"];f [label="G3 | Independent engineer + community CHECK",fillcolor="#ffedc3"];g [label="Supplier certification, cost, inspection + printability"];h [label="G4 | Procurement conflict / quality CHECK",fillcolor="#ffedc3"];i [label="PEP release decision + signed authorisation\nG5 | Authority CHECK",fillcolor="#ffedc3"];j [label="Geotagged versioned building registry + BLIGHT scenario handoff\nConcept only until evidence and approvals are complete",fillcolor="#dbefe8"];a->b->c->d->e->f->g->h->i->j;}
